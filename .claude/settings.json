{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Read(./.env.test)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Edit(./.env.development)",
      "Edit(./.env.production)",
      "Edit(./.env.staging)",
      "Edit(./.env.test)",
      "Bash(* .env)",
      "Bash(* .env *)",
      "Bash(*/.env)",
      "Bash(*/.env *)",
      "Bash(*.env.local*)",
      "Bash(*.env.development*)",
      "Bash(*.env.production*)",
      "Bash(*.env.staging*)",
      "Bash(*.env.test*)",
      "PowerShell(* .env)",
      "PowerShell(* .env *)",
      "PowerShell(*/.env)",
      "PowerShell(*/.env *)",
      "PowerShell(*\\.env)",
      "PowerShell(*\\.env *)",
      "PowerShell(*.env.local*)",
      "PowerShell(*.env.development*)",
      "PowerShell(*.env.production*)",
      "PowerShell(*.env.staging*)",
      "PowerShell(*.env.test*)"
    ]
  }
}
