rules_version = '2';

// Written from the reads and writes the client makes. Before deploying,
// compare with the rules live in the Firebase console: a stricter ruleset
// can lock out clients that are already installed.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      // People search (a prefix query on nameLower) and peer public-key
      // lookups both read other users' docs. This exposes name and email to
      // every signed-in user.
      allow read: if signedIn();

      allow create, delete: if isOwner(uid);

      // The identity public key is write-once. Replacing it would make every
      // existing direct message undecryptable on every device, so even the
      // owner's own client cannot do it. Deleting the account doc is the
      // only way to clear it.
      allow update: if isOwner(uid)
        && (
          !('publicKey' in resource.data)
          || request.resource.data.get('publicKey', null) == resource.data.publicKey
        );

      // A cosmetic list of signed-in devices. Not access control.
      match /devices/{deviceId} {
        allow read, write: if isOwner(uid);
      }

      // Device-linking handshakes. The crypto in deviceLink.ts assumes that
      // nobody outside the account can read or write these.
      match /linkSessions/{code} {
        allow read, write: if isOwner(uid);
      }
    }

    match /conversations/{conversationId} {
      function isGroup(data) {
        return data.get('isGroup', false) == true;
      }

      // A direct chat's id is its two uids, sorted and joined with "_".
      function isDirectIdFor(participants) {
        return participants.size() == 2
          && participants[0] != participants[1]
          && conversationId == (
            participants[0] < participants[1]
              ? participants[0] + '_' + participants[1]
              : participants[1] + '_' + participants[0]
          );
      }

      // The client reads a direct chat's doc before creating it, so a
      // missing doc must be readable by the two people its id names.
      allow get: if signedIn() && (
        resource == null
          ? request.auth.uid in conversationId.split('_')
          : request.auth.uid in resource.data.participants
      );

      // Matches the chat list query: participants array-contains the caller.
      allow list: if signedIn() && request.auth.uid in resource.data.participants;

      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && (
          isGroup(request.resource.data)
            ? request.resource.data.createdBy == request.auth.uid
            : isDirectIdFor(request.resource.data.participants)
        );

      // Participants update the summary fields (last message, unread counts,
      // read receipts). A chat cannot change kind. Members can only be
      // added, and only to a group.
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && isGroup(request.resource.data) == isGroup(resource.data)
        && (
          request.resource.data.participants == resource.data.participants
          || (
            isGroup(resource.data)
            && request.resource.data.participants.hasAll(resource.data.participants)
          )
        );

      match /messages/{messageId} {
        function conversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }

        function inConversation() {
          return signedIn() && request.auth.uid in conversation().participants;
        }

        allow read: if inConversation();

        // Messages are immutable: no update, no delete. A direct chat only
        // accepts ciphertext, so a client bug cannot send plaintext there.
        allow create: if inConversation()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && (
            isGroup(conversation())
            || request.resource.data.encrypted == true
          );
      }
    }
  }
}
